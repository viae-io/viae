{
  "name": "viae",
  "version": "3.0.0-beta.4",
  "private": false,
  "type": "module",
  "description": "bi-directional binary streaming req/res framework",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "clean": "cross-env rimraf .tmp .nyc_output coverage dist",
    "test": "node --import tsx/esm --no-warnings --test test/**/*.spec.ts",
    "bench": "node --experimental-strip-types --experimental-transform-types --no-warnings bench/codec.bench.ts",
    "bench:stream": "node --import tsx/esm --no-warnings bench/stream.bench.ts",
    "build": "tsc --build tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "author": "Meirion Hughes <crakinshot@yahoo.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "latest",
    "@types/mocha": "latest",
    "@types/node": "^22.19.15",
    "@types/ws": "latest",
    "c8": "latest",
    "chai": "latest",
    "cross-env": "latest",
    "mocha": "^11.3.0",
    "rimraf": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "ws": "latest"
  },
  "dependencies": {
    "cbor-x": "^1.6.3",
    "eventemitter3": "^5",
    "path-to-regexp": "^6",
    "rowan": "^2.1.0"
  }
}
